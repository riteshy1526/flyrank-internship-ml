   "source": [
    "# Train model\n",
    "model = RandomForestRegressor(\n",
    "    n_estimators=200,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "# Predictions\n",
    "pred = model.predict(X_test)\n",
    "\n",
    "# Metrics\n",
    "rf_mae = mean_absolute_error(y_test, pred)\n",
    "rf_r2 = r2_score(y_test, pred)\n",
    "\n",
    "print(\"Random Forest MAE:\", round(rf_mae,2))\n",
    "print(\"Random Forest R²:\", round(rf_r2,3))\n",
    "\n",
    "# Replace this with your actual Week 4 baseline MAE\n",
    "baseline_mae = 112.80\n",
    "\n",
    "comparison = pd.DataFrame({\n",
    "    \"Model\": [\"Week 4 Baseline\", \"Random Forest\"],\n",
    "    \"MAE\": [baseline_mae, rf_mae]\n",
    "})\n",
    "\n",
    "comparison"
   ]
  },
