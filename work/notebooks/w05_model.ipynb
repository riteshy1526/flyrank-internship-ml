    "An 80/20 train-test split with a fixed random state was used to ensure reproducibility. The same split is used for both the baseline and Random Forest model so that the comparison is fair.\n",
    "\n",
    "The model is trained only on the training set and evaluated on unseen test data. This provides an honest estimate of model performance for future content pages."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "cc59c5d2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training samples: 24000\n",
      "Testing samples: 6000\n"
     ]
    }
   ],
   "source": [
    "# Load dataset\n",
    "df = pd.read_csv(\"../../data/raw/content_refresh_anonymized.csv\")\n",
    "\n",
    "# Selected features\n",
    "features = [\n",
    "    \"search_volume\",\n",
    "    \"competition\",\n",
    "    \"cpc\",\n",
    "    \"word_count\",\n",
    "    \"char_count\",\n",
    "    \"content_age_days\",\n",
    "    \"days_since_last_update\",\n",
    "    \"ctr\",\n",
    "    \"avg_position\",\n",
    "    \"engagement_rate\",\n",
    "    \"scroll_rate\",\n",
    "    \"trend_pct\"\n",
    "]\n",
    "\n",
    "target = \"sessions_90d\"\n",
    "\n",
    "X = df[features]\n",
    "y = df[target]\n",
    "\n",
    "# Handle missing values\n",
    "X = X.fillna(0)\n",
    "\n",
    "# Split\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X,\n",
    "    y,\n",
    "    test_size=0.20,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "print(\"Training samples:\", len(X_train))\n",
    "print(\"Testing samples:\", len(X_test))"
   ]
  },
